# Copy this file to `.env` on the server and fill in real values.
# `.env` is gitignored — never commit real secrets.

# Local dev only: connects to the postgres container started outside Docker
# Compose. Inside `docker compose`, DATABASE_URI is overridden automatically
# to point at the `db` service — you don't need to change this line for
# a Docker deploy, only for running `npm run dev` directly on a machine.
DATABASE_URI=postgres://payload:payload@127.0.0.1:5433/kvitkova

# Generate a real one before deploying: `openssl rand -base64 32`
# Never reuse the local dev-only value in production.
PAYLOAD_SECRET=

# The site's real public URL (used for redirect/webhook URLs and baked into
# the client bundle at build time — changing it after a Docker deploy
# requires rebuilding the image: `docker compose build app`).
NEXT_PUBLIC_SERVER_URL=https://your-domain.example

CRM_WEBHOOK_URL=

# Nova Poshta JSON API v2.0 — free key at https://devcenter.novaposhta.ua/
NOVA_POSHTA_API_KEY=

# Monobank Acquiring (monopay) — X-Token from your approved merchant account
MONOBANK_TOKEN=
