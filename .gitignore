# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# payload uploads (local dev storage)
/media

# generated by scripts/export-for-deploy.sh — contains a full DB dump,
# never belongs in git history
/deploy-export
/dump.sql
/media.tar.gz

# scraped assets used only by scripts/seed.mjs, not ours to redistribute in git history
/scripts/seed-assets

.superpowers/
.worktrees/
